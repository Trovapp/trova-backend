        "required": ["name", "region", "category", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "region": {"type": "string"},
          "category": {"type": "string", "enum": ["restaurant", "cafe", "attraction", "lodging", "shopping", "other"]},
          "evidence": {"type": "string", "enum": ["frame", "transcript", "title", "description"]}
        }
      }
    }
  }
}
