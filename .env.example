# 복사해서 .env 로 저장하고 값을 채운 뒤 사용하세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.
# 이 파일(.env.example)에는 절대 실제 값(시크릿)을 넣지 마세요.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REST_API_KEY=
GEMINI_API_KEY=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

FRONTEND_URL=http://localhost:3000

GOOGLE_PLACES_API_KEY=
OPENWEATHER_API_KEY=

# 모바일 앱(JWT) 인증에 사용하는 서명 시크릿. 기본값이 없어 값이 없으면 앱이 아예
# 기동하지 않는다(app.jwt-secret: ${JWT_SECRET}, application.yml 참고). 최소 32바이트
# (256비트) 이상이어야 하며, 예: `openssl rand -base64 48` 로 생성해서 사용할 것.
JWT_SECRET=

# 모바일 앱 딥링크에 사용하는 URL scheme (OAuth2LoginSuccessHandler가
# {MOBILE_REDIRECT_SCHEME}://auth?token=... 형태로 리다이렉트한다)
MOBILE_REDIRECT_SCHEME=trova
