    {
      "id": 14,
      "type": "bargauge",
      "title": "분석 단계별 평균 시간(선택 기간)",
      "description": "영상 분석 한 건을 받기(download)·오디오(audio)·화면(frames)·Gemini 단계로 나눈 평균. 서버 재시작 뒤 분석이 한 번도 없으면 비어 있다(#195). 기간은 오른쪽 위 시간 범위.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "이 기간 기록 없음",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (increase(trova_pipeline_stage_seconds_sum{job=~\"$job\"}[$__range])) / (sum by (stage) (increase(trova_pipeline_stage_seconds_count{job=~\"$job\"}[$__range])) > 0)",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ]
    },
