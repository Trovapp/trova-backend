{
  "apiVersion": 1,
  "policies": [
    {
      "orgId": 1,
      "receiver": "trova-slack-alerts",
      "group_by": [
        "grafana_folder",
        "alertname"
      ],
      "routes": [
        {
          "receiver": "trova-slack-alerts",
          "object_matchers": [
            [
              "severity",
              "=",
              "critical"
            ]
          ],
          "group_wait": "30s",
          "group_interval": "5m",
          "repeat_interval": "1h"
        },
        {
          "receiver": "trova-slack-alerts",
          "object_matchers": [
            [
              "severity",
              "=",
              "warning"
            ]
          ],
          "group_wait": "1m",
          "group_interval": "10m",
          "repeat_interval": "4h"
        }
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    }
  ]
}
