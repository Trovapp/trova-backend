{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "trova-host",
      "folder": "",
      "interval": "1m",
      "rules": [
        {
          "uid": "bg3yd8j9d5fr4a",
          "title": "HighMemoryPressure",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "editorMode": "code",
                "expr": "100 * sum(rate(host_pressure_stall_seconds_total{job=\"trova-prod\", resource=\"memory\", type=\"full\"}[5m]))",
                "instant": true,
                "intervalMs": 1000,
                "legendFormat": "__auto",
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "editorMode": "code",
                "expr": "sum(rate(host_swap_pages_total{job=\"trova-prod\", direction=\"in\"}[5m]))",
                "instant": true,
                "intervalMs": 1000,
                "legendFormat": "__auto",
                "maxDataPoints": 43200,
                "range": false,
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        20
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "C",
                "type": "threshold"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "2m",
          "annotations": {
            "context": "스왑 읽기 {{ with $values.B }}초당 {{ printf \"%.0f\" .Value }}페이지{{ end }}(최근 5분).",
            "current_value": "{{ with $values.A }}{{ printf \"%.1f\" .Value }}%{{ end }}",
            "dashboard_url": "https://indigostork3365.grafana.net/d/trova-essentials",
            "description": "응답이 느려지기 직전 신호입니다. 2026-11 운영 측정 21회에서 이 조건은 조회 오류 8% 이상이던 회차에서만 맞았습니다(평소·조회만 1~6%, 멀쩡한 릴스 분석 18~21%). 영상 분석과 조회가 겹쳤는지 먼저 보세요. 부하 측정 중에는 사일런스를 걸어 두세요.",
            "pending": "2분",
            "runbook_url": "https://github.com/Trovapp/trova-backend/blob/main/docs/runbooks/memory-pressure.md",
            "summary": "최근 5분 동안 모든 프로그램이 메모리를 기다리며 멈춘 시간(PSI memory full)이 20%를 넘었고, 그 상태가 2분 이어졌습니다.",
            "threshold": "20%",
            "title": "서버 메모리 압박(PSI)",
            "value_label": "현재 메모리 대기",
            "window": "최근 5분"
          },
          "labels": {
            "environment": "production",
            "service": "trova-backend",
            "severity": "warning"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
